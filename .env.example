# FindReferee prefers the signed-in local Codex account.
AUTHOR_ATTRIBUTION_PROVIDER=auto
CODEX_MODEL=gpt-5.6-sol
CODEX_REASONING_EFFORT=xhigh
# Set a positive number only to impose an additional per-Codex-call limit.
# The default 0 never kills an in-progress call; phase and overall budgets only
# decide which optional work starts next.
CODEX_TIMEOUT_SECONDS=0
CODEX_TIMEOUT_RETRIES=1
CODEX_TIMEOUT_RETRY_EFFORT=high
CODEX_ENABLE_SEARCH=true
AUTHOR_ATTRIBUTION_TARGET_SECONDS=3300
# The 60-minute planning point is flexible; this keeps scheduling optional work
# for up to 90 minutes while never terminating an in-progress model call.
AUTHOR_ATTRIBUTION_HARD_SECONDS=5400
# Keep a completed or long-running browser job available for four hours.
AUTHOR_ATTRIBUTION_JOB_TTL_SECONDS=14400

# Optional: set this only when Codex is not on PATH.
# CODEX_CLI_PATH=/absolute/path/to/codex

# Optional API fallback. Never commit a real key.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Accuracy and corpus controls.
AUTHOR_ATTRIBUTION_REVIEW_PASSES=1
AUTHOR_ATTRIBUTION_ADAPTIVE_ROUNDS=2
AUTHOR_ATTRIBUTION_MIN_CONFIRMATION_ROUNDS=1
AUTHOR_ATTRIBUTION_MIN_MARGIN_GAIN=0.03
AUTHOR_ATTRIBUTION_PUBLIC_CORPUS=true
AUTHOR_ATTRIBUTION_PUBLIC_METADATA_RESULTS=80
AUTHOR_ATTRIBUTION_PUBLIC_FULL_TEXTS=8
AUTHOR_ATTRIBUTION_CITATION_NETWORK=true

# Optional public citation-graph settings. No key is required for ordinary use.
# SEMANTIC_SCHOLAR_API_KEY=
# AUTHOR_ATTRIBUTION_CITATION_CACHE=/absolute/path/to/cache
