# FindReferee prefers the signed-in local Codex account.
AUTHOR_ATTRIBUTION_PROVIDER=auto
CODEX_MODEL=gpt-5.6-sol
CODEX_REASONING_EFFORT=xhigh
CODEX_TIMEOUT_SECONDS=1200
CODEX_ENABLE_SEARCH=true

# Extra hosted frontends may be added as a comma-separated allowlist.
# The official https://mingchenxia.github.io frontend is already allowed.
# FINDREFEREE_ALLOWED_ORIGINS=https://example.github.io

# Optional: set this only when Codex is not on PATH.
# CODEX_CLI_PATH=/absolute/path/to/codex

# Optional API fallback. Never commit a real key.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Accuracy and corpus controls.
AUTHOR_ATTRIBUTION_REVIEW_PASSES=1
AUTHOR_ATTRIBUTION_ADAPTIVE_ROUNDS=3
AUTHOR_ATTRIBUTION_MIN_CONFIRMATION_ROUNDS=1
AUTHOR_ATTRIBUTION_PUBLIC_CORPUS=true
AUTHOR_ATTRIBUTION_PUBLIC_METADATA_RESULTS=80
AUTHOR_ATTRIBUTION_PUBLIC_FULL_TEXTS=6
